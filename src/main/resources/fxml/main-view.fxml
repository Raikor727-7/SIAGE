<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="br.prefeitura.consulta_alunos.controller.MainController" alignment="TOP_CENTER" style="-fx-padding: 15;">
    <HBox spacing="10">
        <Button text="Selecionar Arquivo Excel" onAction="#selecionarArquivo"/>
        <TextField fx:id="campoBusca" promptText="Buscar aluno por nome..." onKeyReleased="#filtrarAlunos" HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox spacing="10">
        <ComboBox fx:id="comboCaixa" promptText="Filtrar por caixa" onAction="#filtrarPorCaixa"/>
        <ComboBox fx:id="comboAno" promptText="Filtrar por ano" onAction="#filtrarPorAno"/>
        <Button text="Limpar Filtros" onAction="#limparFiltros"/>
    </HBox>

    <TableView fx:id="tabelaAlunos" prefHeight="500">
        <columns>
            <TableColumn text="Nome" fx:id="colNome" prefWidth="250"/>
            <TableColumn text="Data Nascimento" fx:id="colDataNascimento" prefWidth="120"/>
            <TableColumn text="Idade Atual" fx:id="colIdade" prefWidth="80"/>
            <TableColumn text="Caixa/Arquivo" fx:id="colCaixa" prefWidth="150"/>
            <TableColumn text="Ano Referência" fx:id="colAno" prefWidth="100"/>
            <TableColumn text="Situação" fx:id="colSituacao" prefWidth="120"/>
        </columns>
    </TableView>

    <Label fx:id="labelInfo" text="Selecione um arquivo Excel para carregar os dados históricos"/>
</VBox>